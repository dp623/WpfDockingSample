<Window x:Class="WpfDockingSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfDockingSample"
        Title="WPF Docking UI Sample" Width="1180" Height="760"
        MinWidth="850" MinHeight="520" Background="#FF1E1E1E">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate x:Key="DockItemTemplate" DataType="{x:Type local:DockItem}">
            <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                     Foreground="Gainsboro" Background="#FF1E1E1E"
                     BorderThickness="0" Padding="14" FontFamily="Consolas"
                     FontSize="14" AcceptsReturn="True" AcceptsTab="True">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="IsReadOnly" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDocument}" Value="False">
                                <Setter Property="IsReadOnly" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF333337" Padding="10,7">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Docking Sample" Foreground="White" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                <Button Content="ツールを追加" Command="{Binding AddToolCommand}"
                        Margin="0,0,6,0" Padding="10,4"/>
                <Button Content="ドキュメントを追加" Command="{Binding AddDocumentCommand}"
                        Padding="10,4"/>
                <TextBlock Text="タブをドラッグ：中央＝タブ化／端＝分割／作業領域外＝キャンセル"
                           Foreground="#FFCECECE" VerticalAlignment="Center" Margin="24,0,0,0"/>
            </StackPanel>
        </Border>

        <local:DockingManager ItemsSource="{Binding Items}"
                              ItemTemplate="{StaticResource DockItemTemplate}"/>
    </DockPanel>
</Window>
