<Window x:Class="WpfDockingSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Docking UI Sample" Width="1180" Height="760"
        MinWidth="850" MinHeight="520" Background="#FF1E1E1E"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave"
        PreviewDrop="Window_PreviewDrop">
    <Window.Resources>
        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="#FF46464A"/>
            <Setter Property="ShowsPreview" Value="True"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF333337" Padding="10,7">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Docking Sample" Foreground="White" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                <Button Content="ツールを追加" Tag="Tool" Click="AddItem_Click"
                        Margin="0,0,6,0" Padding="10,4"/>
                <Button Content="ドキュメントを追加" Tag="Document" Click="AddItem_Click"
                        Padding="10,4"/>
                <TextBlock Text="タブをドラッグ：中央＝タブ化／端＝分割／作業領域外＝キャンセル"
                           Foreground="#FFCECECE" VerticalAlignment="Center" Margin="24,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid x:Name="DockWorkspace">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="130"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="250" MinWidth="130"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="210" MinHeight="110"/>
            </Grid.RowDefinitions>

            <ContentControl x:Name="LeftRoot" Grid.Column="0" Grid.Row="0" Grid.RowSpan="3"/>
            <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                          HorizontalAlignment="Stretch"/>

            <ContentControl x:Name="DocumentRoot" Grid.Column="2" Grid.Row="0"/>

            <GridSplitter Grid.Column="3" Grid.Row="0" Grid.RowSpan="3"
                          HorizontalAlignment="Stretch"/>
            <ContentControl x:Name="RightRoot" Grid.Column="4" Grid.Row="0" Grid.RowSpan="3"/>

            <GridSplitter Grid.Column="2" Grid.Row="1"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <ContentControl x:Name="BottomRoot" Grid.Column="2" Grid.Row="2"/>
        </Grid>
    </DockPanel>
</Window>
